<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ArkoviaCrossplay</AssemblyName>
    <RootNamespace>ArkoviaCrossplay</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>My Creation Haven</Authors>
    <Description>Optional Terraria 1.4.5.x handshake compatibility bridge for Arkovia TShock servers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TShock" Version="6.1.0" />
  </ItemGroup>
</Project>
